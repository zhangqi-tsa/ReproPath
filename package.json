{
  "name": "repropath", "private": true, "version": "0.1.1", "type": "module",
  "packageManager": "pnpm@10.17.1", "engines": { "node": ">=22.12.0", "pnpm": ">=10 <11" },
  "scripts": {
    "postinstall": "playwright install chromium",
    "dev": "concurrently --kill-others -n worker,control,web \"pnpm --filter @repropath/browser-worker dev\" \"pnpm --filter @repropath/control dev\" \"pnpm --filter @repropath/web dev\"",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:smoke": "tsx --test tests/smoke.test.ts",
    "build": "pnpm --filter @repropath/web build"
  },
  "devDependencies": {
    "@repropath/protocol": "workspace:*", "@types/node": "^22.15.0", "@types/ws": "^8.18.0",
    "concurrently": "^9.1.2", "playwright": "1.55.1", "tsx": "^4.20.5", "typescript": "^5.9.2", "vite": "^7.1.5", "ws": "^8.18.3"
  }
}
